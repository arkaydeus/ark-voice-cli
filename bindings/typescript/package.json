{
  "name": "ark-voice-client",
  "version": "0.1.0",
  "description": "TypeScript client for the ark-voice socket server (ark-voice serve).",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:node": "tsc -p tsconfig.build.json && node --test test-node/smoke.test.mjs"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^20",
    "typescript": "^7"
  }
}
